#!/bin/sh
# SPDX-License-Identifier: MIT
# Blocks a push to a public remote that carries a private term (see privacy-ci.mjs).
# Modes (privacy-ci.mjs): private rules with an inventory; otherwise public rules
# with a notice, or a block when the clone requires the private rules. Two switches
# require them, both read as git booleans: env CODESENSE_PRIVACY_REQUIRED, or git
# config codesense.privacyRequired (the most local scope wins, as usual in git).
# Without node, fallback.sh allows with a notice (CI scans it) or blocks when required.
here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd) || exit 1
if ! command -v node >/dev/null 2>&1; then
  # shellcheck source=scripts/git-hooks/fallback.sh
  . "$here/fallback.sh"
  if is_public "${2:-${1:-}}"; then
    require_signed_check "a push to ${1:-}"
    unscanned "a push to ${1:-}"
  fi
  exit 0
fi
# An installed dispatcher from before the signed-commit check: ask for a reinstall.
if hooks=$(git rev-parse --path-format=absolute --git-path hooks 2>/dev/null) &&
  grep -q codesense-privacy-hook-dispatcher "$hooks/pre-push" 2>/dev/null &&
  ! grep -q "codesense-privacy-hook-version: 2" "$hooks/pre-push" 2>/dev/null; then
  echo "privacy hook: the installed dispatcher is out of date; rerun scripts/git-hooks/install.sh" >&2
fi
exec node "$here/../privacy-ci.mjs" --hook pre-push "$@"
