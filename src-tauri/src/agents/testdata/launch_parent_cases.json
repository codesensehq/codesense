        "allow": [
          "Edit(//a/b/foreman-*/**)"
        ]
      }
    },
    "unexpanded": []
  },
  {
    "name": "the token anywhere but the whole first segment after // is unexpandable: allows dropped, denies and asks kept as written",
    "cwd": "/a/b/content",
    "settings": {
      "permissions": {
        "allow": [
          "Edit(./**)",
          "Bash(echo {{launch_parent}})",
          "Read({{launch_parent}}/x)",
          "Edit(/{{launch_parent}}/x)",
          "Edit(//x/{{launch_parent}}/y)",
          "Edit(//{{launch_parent}}x/y)",
          "Edit(//{{launch_parent}}/{{launch_parent}}/z)",
          "Grep(//{{launch_parent}}/x)",
          "edit(//{{launch_parent}}/x)",
          "Edit(//{{launch_parent}}/x"
        ],
        "deny": [
          "Bash(echo {{launch_parent}})",
          "Edit({{launch_parent}}/x)"
        ],
        "ask": [
          "Read(//a/{{launch_parent}})"
        ]
      }
    },
    "expect": {
      "permissions": {
        "allow": [
          "Edit(./**)"
        ],
        "deny": [
          "Bash(echo {{launch_parent}})",
          "Edit({{launch_parent}}/x)"
        ],
        "ask": [
          "Read(//a/{{launch_parent}})"
        ]
      }
    },
    "unexpanded": [
      {
        "list": "allow",
        "rule": "Bash(echo {{launch_parent}})",
        "dropped": true,
        "reason": "position"
      },
      {
        "list": "allow",
        "rule": "Read({{launch_parent}}/x)",
        "dropped": true,
        "reason": "position"
      },
      {
        "list": "allow",
        "rule": "Edit(/{{launch_parent}}/x)",
        "dropped": true,
        "reason": "position"
      },
      {
        "list": "allow",
        "rule": "Edit(//x/{{launch_parent}}/y)",
        "dropped": true,
        "reason": "position"
      },
      {
        "list": "allow",
        "rule": "Edit(//{{launch_parent}}x/y)",
        "dropped": true,
        "reason": "position"
      },
      {
        "list": "allow",
        "rule": "Edit(//{{launch_parent}}/{{launch_parent}}/z)",
        "dropped": true,
        "reason": "position"
      },
      {
        "list": "allow",
        "rule": "Grep(//{{launch_parent}}/x)",
        "dropped": true,
        "reason": "position"
      },
      {
        "list": "allow",
        "rule": "edit(//{{launch_parent}}/x)",
        "dropped": true,
        "reason": "position"
      },
      {
        "list": "allow",
        "rule": "Edit(//{{launch_parent}}/x",
        "dropped": true,
        "reason": "position"
      },
      {
        "list": "deny",
        "rule": "Bash(echo {{launch_parent}})",
        "dropped": false,
        "reason": "position"
      },
      {
        "list": "deny",
        "rule": "Edit({{launch_parent}}/x)",
        "dropped": false,
        "reason": "position"
      },
      {
        "list": "ask",
        "rule": "Read(//a/{{launch_parent}})",
        "dropped": false,
        "reason": "position"
      }
    ]
  },
