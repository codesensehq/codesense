[
  {
    "name": "the Foreman's file allows take the launch folder's parent; every other rule and key is verbatim",
    "cwd": "/a/b/content",
    "settings": {
      "permissions": {
        "defaultMode": "dontAsk",
        "allow": [
          "mcp__codesense__reply",
          "Read(//{{launch_parent}}/foreman-*/**)",
          "Edit(//{{launch_parent}}/foreman-*/**)",
          "Write(//{{launch_parent}}/foreman-*/**)",
          "Read(//{{launch_parent}}/foreman-*.msg)",
          "Write(//{{launch_parent}}/foreman-*.msg)",
          "Bash(git -C ../foreman-* status)",
          "Edit(./**)"
        ],
        "deny": [
          "Edit(./**)",
          "Edit(//**/.git/**)",
          "Bash(git -C * -C *)"
        ]
      },
      "env": {
        "KEEP": "{{launch_parent}}"
      }
    },
    "expect": {
      "permissions": {
        "defaultMode": "dontAsk",
        "allow": [
          "mcp__codesense__reply",
          "Read(//a/b/foreman-*/**)",
          "Edit(//a/b/foreman-*/**)",
          "Write(//a/b/foreman-*/**)",
          "Read(//a/b/foreman-*.msg)",
          "Write(//a/b/foreman-*.msg)",
          "Bash(git -C ../foreman-* status)",
          "Edit(./**)"
        ],
        "deny": [
          "Edit(./**)",
          "Edit(//**/.git/**)",
          "Bash(git -C * -C *)"
        ]
      },
      "env": {
        "KEEP": "{{launch_parent}}"
      }
    },
    "unexpanded": []
  },
  {
    "name": "deny, ask and every file tool expand; a trailing slash on the launch folder is ignored",
    "cwd": "/a/b/content/",
    "settings": {
      "permissions": {
        "allow": [
          "NotebookEdit(//{{launch_parent}}/n/**)",
          "Edit(//{{launch_parent}})"
        ],
        "deny": [
          "Edit(//{{launch_parent}}/foreman-*/.git/**)"
        ],
        "ask": [
          "Write(//{{launch_parent}}/foreman-*/x)"
        ]
      }
    },
    "expect": {
      "permissions": {
        "allow": [
          "NotebookEdit(//a/b/n/**)",
          "Edit(//a/b)"
        ],
        "deny": [
          "Edit(//a/b/foreman-*/.git/**)"
        ],
        "ask": [
          "Write(//a/b/foreman-*/x)"
        ]
      }
    },
    "unexpanded": []
  },
  {
    "name": "a parent of / gives //foreman-*, never ///",
