          "Write(//{{launch_parent}}/foreman-*.msg)"
        ],
        "deny": [
          "Edit(//{{launch_parent}}/foreman-*/.git/**)"
        ]
      }
    },
    "expect": {
      "permissions": {
        "allow": [
          "Read(//foreman-*/**)",
          "Edit(//foreman-*/**)",
          "Write(//foreman-*/**)",
          "Read(//foreman-*.msg)",
          "Write(//foreman-*.msg)"
        ],
        "deny": [
          "Edit(//foreman-*/.git/**)"
        ]
      }
    },
    "unexpanded": []
  },
  {
    "name": "a glob character in the launch folder's own name is not in the parent",
    "cwd": "/a/b/con*tent",
