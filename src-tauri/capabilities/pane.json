{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "pane",
  "description": "Capability for satellite windows",
  "windows": ["pane-*"],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "core:app:default",
    "core:path:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "log:default",
    "opener:allow-open-url",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
