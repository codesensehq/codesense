{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A setup step (step_format 1)",
  "description": "One setup step: check, ask, do, confirm, record, undo. The guide agent reads these files and acts only after the person's click; the engine never runs them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["step_format", "id", "title", "summary", "record", "undo"],
  "properties": {
    "step_format": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 400 },
    "needs": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "when": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "any_source_repo_host": { "type": "string", "minLength": 1 },
        "tracker": { "enum": ["github", "jira", "linear", "none"] }
      }
    },
    "probe": { "type": "array", "items": { "$ref": "#/$defs/probe" } },
    "ask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "act"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 60 },
              "act": { "type": "string", "minLength": 1 }
            }
          }
        },
        "free_text": { "type": "boolean" },
        "recommend": { "type": "string", "minLength": 1 }
      }
    },
    "act": { "type": "array", "items": { "$ref": "#/$defs/act" } },
    "inputs": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern"],
        "properties": {
          "pattern": { "type": "string", "pattern": "^\\^.*\\$$" },
          "label": { "type": "string" },
          "shareable": { "type": "boolean" },
          "list": { "type": "boolean" }
        }
      }
    },
    "verify": {
      "description": "The step's state: the most-done state its verify probes read. The agent reads it before the card, so a re-run skips a done step, and after the act to check it worked. A probe that only a new session can read (a ledger row) sits beside one that reads the act's own result.",
      "type": "object",
      "additionalProperties": false,
      "required": ["probe", "expect"],
      "properties": {
        "probe": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1,
              "uniqueItems": true
            }
          ]
        },
        "expect": { "enum": ["done", "missing", "partial", "unknown"] }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "secret"],
      "properties": {
        "scope": { "enum": ["team", "machine"] },
        "fields": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "secret": { "const": "never" }
      }
    },
    "undo": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "^[^\\n]+$" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64 },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "check", "map"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "check": {
          "type": "object",
          "required": ["tool"],
          "properties": { "tool": { "type": "string", "minLength": 1 } }
        },
        "pick": {
          "description": "Which entry of the tool's result the probe reads: a result field to the value it must have, or {not: value}. More than one match means asking the person which.",
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": ["string", "number", "boolean"] },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["not"],
                "properties": { "not": { "type": ["string", "number", "boolean"] } }
              }
            ]
          }
        },
        "yields": {
          "description": "The values `{{probe.<id>.<name>}}` may use: each name to a field the tool returns, read from the picked entry.",
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "map": {
          "description": "What the probe reads to a state. The keys are `found` (the pick matched an entry, or with no pick the tool answered), `none` (nothing matched, or an argument has no value yet) and `unreadable` (the tool failed); a probe that yields a field with a fixed set of values maps each value in place of `found`, and across several entries the least-done state counts. The pack build checks the keys against the tool's registry.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "enum": ["done", "missing", "partial", "unknown"] }
        }
      }
    },
    "act": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "consent", "what", "where", "why"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "consent": { "enum": ["read", "local-write", "install-or-sign-in", "external-write"] },
        "what": { "type": "string", "minLength": 1 },
        "where": { "type": "string", "minLength": 1 },
        "why": { "type": "string", "minLength": 1 },
        "verb": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool"],
          "properties": {
            "tool": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "args": { "type": "object" }
          }
        },
        "run": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cmd", "in"],
          "properties": {
            "cmd": { "type": "string", "minLength": 1 },
            "in": { "enum": ["terminal_tab", "headless"] },
            "cwd": { "type": "string" }
          }
        },
        "open_url": { "type": "string", "pattern": "^https://" },
        "then": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "repeat": { "type": "integer", "minimum": 1, "maximum": 10 },
        "wait": {
          "type": "object",
          "additionalProperties": false,
          "required": ["until", "then", "timeout"],
          "properties": {
            "until": { "enum": ["tab_exit"] },
            "then": { "enum": ["verify"] },
            "timeout": { "type": "string", "pattern": "^[0-9]+[smh]$" }
          }
        }
      },
      "oneOf": [
        { "required": ["verb"] },
        { "required": ["run"] },
        { "required": ["open_url"] }
      ]
    }
  }
}
